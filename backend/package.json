{
  "name": "workflow-orchestrator-backend",
  "version": "0.1.0",
  "private": true,
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon --watch src --exec node src/server.js",
    "start": "node src/server.js",
    "worker": "node src/workers/index.js",
    "prisma": "prisma generate --schema=src/prisma/schema.prisma",
    "test": "jest",
    "test:unit": "jest --runInBand tests/validator.test.js",
    "test:integration": "jest --runInBand tests/workflow.integration.test.js",
    "lint": "eslint . --ext .js,.mjs,.cjs",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,md}\""
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "axios": "^1.4.0",
    "bcrypt": "^5.1.0",
    "bullmq": "^1.81.0",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^4.18.2",
    "helmet": "^6.0.1",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.0",
    "node-cron": "^3.0.2",
    "nodemailer": "^6.9.4",
    "pino": "^8.9.0",
    "prisma": "^5.22.0",
    "socket.io": "^4.7.1",
    "express-rate-limit": "^6.9.0",
    "zod": "^3.21.4",
    "@prisma/client": "^5.22.0"
  },
  "devDependencies": {
    "eslint": "^8.50.0",
    "eslint-config-prettier": "^9.0.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "prettier": "^2.8.8",
    "supertest": "^6.3.3"
  }
}
